# trading-signal-frontend — 로컬 환경변수 템플릿
#
# 본 파일은 `.env.local` 의 dummy 값 + 주석. 실 키는 `.env.local` 에만 두고 commit 금지.
# `.gitignore` 가 `.env.*` 차단 + `!.env.example` 만 예외. `.env.local.example` 도 본 파일로 별도 예외.
#
# PRD `stock-api-integration` §3.7, AC-12 정합.
#
# 사용:
#   1. 본 파일을 `.env.local` 로 복사 (`cp .env.local.example .env.local`).
#   2. 실 키를 채워 넣는다.
#   3. dev 서버 재시작.
#
# 환경변수 미설정 시: BFF route 가 mock fallback 반환 (`X-Data-Source: mock` 헤더).
# 빌드 타임 키 검증 0 — Vercel preview 보호.

# =========================
# 앱 비밀번호 게이트 (PRD app-password-gate)
# =========================
#
# 앱 전체를 단일 공유 비밀번호로 보호(루트 middleware). 서버 전용 — NEXT_PUBLIC_ 금지.
#
# 로컬 개발: 두 키를 비워두면 게이트 비활성(앱 공개)이라 로그인 없이 그대로 뜬다.
# 게이트를 로컬에서 검증하려면 아래 두 값을 채우고 dev 서버를 재시작:
#   APP_PASSWORD=openssl rand -base64 24 결과 (또는 임의 16자+)
#   APP_AUTH_SECRET=openssl rand -hex 32 결과
# ⚠️ 프로덕션(Vercel)은 Project Settings 에 두 키를 반드시 등록(미설정 시 도메인 공개).
APP_PASSWORD=
APP_AUTH_SECRET=


# =========================
# KIS Developers (한국투자증권 Open API)
# =========================
#
# 발급:
#   1. 한국투자증권 계좌 개설 + HTS ID 연결.
#   2. https://apiportal.koreainvestment.com 회원가입.
#   3. [Open API 서비스 신청] → 모의투자 / 실전투자 키 각각 발급.

# 36자 App Key (모의 / 실전 환경별 별도)
KIS_APP_KEY=

# 180자 App Secret
KIS_APP_SECRET=

# 8자리 계좌번호 (모의: 50190357 형식). 본 PR-A (조회) 는 미사용, 후속 주문 PRD 에서 사용.
KIS_ACCOUNT_NO=

# 2자리 상품코드 (보통 "01"). 본 PR-A 는 미사용.
KIS_ACCOUNT_PRODUCT_CD=01

# "vts" (모의, 기본) | "prod" (실전, 권장 X)
# ⚠️ "prod" 사용 시 실전계좌에 호출량이 카운트됩니다. 주문은 본 PRD 범위 밖이지만 조회도 실전 호출.
KIS_ENV=vts

# 토큰 캐시 위치 — 본 PR-A 는 "memory" 만 구현. "kv" 는 후속 PRD 의 placeholder.
KIS_TOKEN_STORE=memory


# =========================
# OpenDART (금융감독원 전자공시시스템)
# =========================
#
# 발급:
#   1. https://opendart.fss.or.kr 회원가입 (무료).
#   2. [인증키 신청/관리] → 인증키 발급 (즉시).

# 40자 API Key
OPENDART_API_KEY=


# =========================
# FastAPI BE (선행 PRD claude-cli-analysis)
# =========================
#
# 본 PR-A 와 무관 — 기존 워크벤치 분석 기능이 사용.
FASTAPI_BASE_URL=http://127.0.0.1:8000
