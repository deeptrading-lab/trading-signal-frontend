# trading-signal-frontend — 로컬 환경변수 템플릿
#
# 본 파일은 `.env.local` 의 dummy 값 + 주석. 실 키는 `.env.local` 에만 두고 commit 금지.
# `.gitignore` 가 `.env.*` 차단 + `!.env.example` 만 예외. `.env.local.example` 도 본 파일로 별도 예외.
#
# PRD `stock-api-integration` §3.7, AC-12 정합.
#
# 사용:
#   1. 본 파일을 `.env.local` 로 복사 (`cp .env.local.example .env.local`).
#   2. 실 키를 채워 넣는다.
#   3. dev 서버 재시작.
#
# 환경변수 미설정 시: BFF route 가 mock fallback 반환 (`X-Data-Source: mock` 헤더).
# 빌드 타임 키 검증 0 — Vercel preview 보호.

# =========================
# 앱 비밀번호 게이트 (PRD app-password-gate)
# =========================
#
# 앱 전체를 단일 공유 비밀번호로 보호(루트 middleware). 서버 전용 — NEXT_PUBLIC_ 금지.
#
# 로컬 개발: 두 키를 비워두면 게이트 비활성(앱 공개)이라 로그인 없이 그대로 뜬다.
# 게이트를 로컬에서 검증하려면 아래 두 값을 채우고 dev 서버를 재시작:
#   APP_PASSWORD=openssl rand -base64 24 결과 (또는 임의 16자+)
#   APP_AUTH_SECRET=openssl rand -hex 32 결과
# ⚠️ 프로덕션(Vercel)은 Project Settings 에 두 키를 반드시 등록(미설정 시 도메인 공개).
APP_PASSWORD=
APP_AUTH_SECRET=


# =========================
# Google 로그인 + 승인 게이트 (PRD user-login-auth)
# =========================
#
# Google OAuth 로 신원 확인 → 관리자 승인(profiles.status=approved)한 사용자만 접근.
# 아래 3종이 모두 있으면 게이트 활성 + /login 에 "Google로 계속하기" 버튼 노출.
# 비어 있으면 위 APP_PASSWORD 폴백(둘 다 없으면 앱 공개). 신원 세션은 위 APP_AUTH_SECRET 로 서명.
# ⚠️ 서버 전용 — NEXT_PUBLIC_ 금지. client_secret 은 브라우저에 절대 노출하지 않는다.
#
# 발급: Google Cloud Console → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹 애플리케이션).
#   승인된 리디렉션 URI 에 아래 REDIRECT_URI 를 정확히 등록(로컬/prod 각각).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 콜백 주소 — Google 콘솔 등록값과 정확히 일치(포트·경로·슬래시까지).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# 최초 관리자 시드(콤마 구분, 소문자). 첫 로그인이 자동 admin+approved(부트스트랩·브레이크글라스).
# ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=
#
# ⚠️ profiles 테이블은 아래 Supabase service-role REST 를 재사용한다(별도 SDK·anon key 불필요).


# =========================
# KIS Developers (한국투자증권 Open API)
# =========================
#
# 발급:
#   1. 한국투자증권 계좌 개설 + HTS ID 연결.
#   2. https://apiportal.koreainvestment.com 회원가입.
#   3. [Open API 서비스 신청] → 모의투자 / 실전투자 키 각각 발급.

# 36자 App Key (모의 / 실전 환경별 별도)
KIS_APP_KEY=

# 180자 App Secret
KIS_APP_SECRET=

# 8자리 계좌번호 (모의: 50190357 형식). 본 PR-A (조회) 는 미사용, 후속 주문 PRD 에서 사용.
KIS_ACCOUNT_NO=

# 2자리 상품코드 (보통 "01"). 본 PR-A 는 미사용.
KIS_ACCOUNT_PRODUCT_CD=01

# "vts" (모의, 기본) | "prod" (실전, 권장 X)
# ⚠️ "prod" 사용 시 실전계좌에 호출량이 카운트됩니다. 주문은 본 PRD 범위 밖이지만 조회도 실전 호출.
KIS_ENV=vts

# =========================
# 토스증권 Open API (검토 중 — 아직 앱 코드 미사용)
# =========================
#
# 발급: 토스증권 WTS 로그인 → 설정 → Open API 에서 client_id / client_secret 발급.
# OAuth2 client credentials 방식. ⚠️ 서버 전용 — NEXT_PUBLIC_ 금지. KIS 키와 동일 취급.
# ⚠️ 단일 활성 토큰 — 같은 client_id 로 다른 토큰 캐시 주체(스모크 스크립트, 별도 프로세스)를
#    동시에 돌리면 서로 토큰을 무효화한다(401 재시도가 흡수하나, 상시 병행 시 KIS_TOKEN_STORE=kv 권장).
# 스모크 테스트: npm run toss:smoke (scripts/tossSmokeTest.mjs)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 시세 데이터 소스 토글 (PRD toss-market-data-adapter):
#   미설정/그 외 값(기본) = "kis" — 기존 동작 그대로.
#   "toss" = 종목 현재가·일봉·기간차트·분봉·종목정보를 토스 어댑터로 서빙.
#            ⚠️ 위 TOSS 키가 없으면 이 값과 무관하게 kis 로 동작(동료 로컬 무영향).
#            토스 호출 실패 시 해당 호출은 KIS 폴백(서버 로그 [marketdata] warn).
#            지수·수급·관심종목 일괄시세는 토스 API 부재/후속으로 항상 KIS.
# MARKET_DATA_SOURCE=toss

# 토큰/지수 캐시 위치 (PRD kis-token-store):
#   "memory" (기본/로컬/테스트) — 인스턴스 메모리 only. 현행 동작.
#   "kv"     — Upstash Redis 공유 store(인스턴스 간 토큰 1회 수렴 + 지수 크로스-라우트 dedup).
# ⚠️ "kv" 인데 아래 Upstash 연결 변수가 없거나 store 에러 시 자동으로 "memory" 로 폴백(fail-soft).
KIS_TOKEN_STORE=memory

# --- Upstash Redis 연결 (KIS_TOKEN_STORE=kv 일 때만 필요) ---
#
# ⚠️ 서버 전용 — NEXT_PUBLIC_ 금지(붙이면 브라우저 번들에 노출). KIS 키와 동일 취급.
# Vercel Marketplace 에서 Upstash for Redis(무료 티어·Regional Tokyo) 연결 시 자동 주입됩니다.
# 통합 버전에 따라 변수명이 KV_REST_API_* 또는 UPSTASH_REDIS_REST_* 로 다를 수 있어
# 코드가 둘 다 흡수합니다(둘 중 채워진 쪽 사용). 로컬은 `vercel env pull .env.local` 로 내려받거나
# Upstash 콘솔에서 REST URL/TOKEN 을 복사해 둘 중 한 네이밍으로 기입.
# 미설정 시 KIS_TOKEN_STORE 값과 무관하게 memory 폴백이라 머지/실행에 무해합니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (대체 네이밍 — 위 KV_REST_API_* 가 비었을 때 사용)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# =========================
# OpenDART (금융감독원 전자공시시스템)
# =========================
#
# 발급:
#   1. https://opendart.fss.or.kr 회원가입 (무료).
#   2. [인증키 신청/관리] → 인증키 발급 (즉시).

# 40자 API Key
OPENDART_API_KEY=


# =========================
# FastAPI BE (선행 PRD claude-cli-analysis)
# =========================
#
# 본 PR-A 와 무관 — 기존 워크벤치 분석 기능이 사용.
FASTAPI_BASE_URL=http://127.0.0.1:8000
