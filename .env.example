# === Frontend (Next.js) ===
#
# 로컬 환경변수 템플릿.
#
#   .env       — 공유 기본값
#   .env.local — 개인/머신 override (override=True 로 .env 위에 덮임)
#
# 사용법:
#   cp .env.example .env.local
#   # .env.local 을 실제 값으로 채움
#
# `.env`, `.env.local` 은 `.gitignore` 의 `.env.*` 패턴으로 차단되며
# `.env.example` 만 예외로 commit 됩니다.

# === 앱 비밀번호 게이트 (PRD app-password-gate) ===
#
# 앱 전체를 단일 공유 비밀번호로 보호한다(루트 middleware 게이트).
# ⚠️ 서버 전용 — NEXT_PUBLIC_ 접두사 금지(붙이면 브라우저 번들에 노출). KIS 키와 동일 취급.
#
# APP_PASSWORD: 공유 비밀번호.
#   - 빈 값/미설정 = 게이트 비활성(앱 전체 공개). 로컬/CI 편의.
#   - 프로덕션 필수 — 미설정 시 Vercel 프로덕션 도메인이 공개됩니다(경고 로그 1회).
#   - 16자 이상 랜덤 권고(카운터/잠금 없이 길이로 온라인 브루트포스 실효성 차단).
#     예: openssl rand -base64 24
APP_PASSWORD=
#
# APP_AUTH_SECRET: 세션 쿠키 HMAC 서명 시크릿(APP_PASSWORD 와 한 쌍).
#   - 랜덤 긴 문자열. 예: openssl rand -hex 32
#   - 회전(변경) 시 발급된 전체 세션이 무효화되어 전원 재로그인(의도된 강제 로그아웃 수단).
APP_AUTH_SECRET=

# trading-signal-engine FastAPI 주소 — Next.js route handler 가 이 값으로 프록시.
# 로컬: engine 레포에서 `ALLOW_UNAUTHENTICATED_WORKBENCH=1 PYTHON=.venv/bin/python make signal-workbench` 로 띄우면 기본값으로 LIVE.
# Vercel 배포 시 Environment Variables 에 동일한 키로 등록합니다.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# === 분석 백엔드 선택 (PRD claude-cli-analysis) ===
#
# `fastapi` (기본): 위 FASTAPI_BASE_URL 의 trading-signal-engine 호출.
# `claude-cli`   : 로컬에 설치된 claude CLI 를 subprocess 로 호출하여 분석 결과를 생성.
#                  Vercel 등 serverless 환경에서는 동작하지 않으며, 런타임 가드가 명시적 에러를 반환합니다.
# 빈 값/오타는 `fastapi` 로 폴백합니다.
ANALYZE_BACKEND=fastapi

# claude CLI 바이너리 경로. PATH 에 있으면 `claude` 그대로 사용.
# 다른 경로에 설치된 경우 절대경로 지정 (예: /Users/<me>/.nvm/versions/node/v20/bin/claude).
CLAUDE_CLI_PATH=claude

# (옵션) claude CLI 의 `--model` 플래그로 전달할 모델 ID 또는 alias.
# 비워두면 claude CLI 기본 모델을 사용합니다.
# CLAUDE_CLI_MODEL=sonnet

# (옵션) user prompt 본문 템플릿 override. 비우면 기본 한글 템플릿을 사용합니다.
# 지원 placeholder: {{ticker}}, {{capital_amount}}, {{target_return_pct}}, {{target_period_days}}, {{max_loss_pct}}
# CLAUDE_PROMPT_TEMPLATE=

# Supabase 는 다음 단계에서 연결 예정입니다.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# === KIS 토큰/지수 공유 store (PRD kis-token-store) ===
#
# KIS 키와 store 연결 변수의 상세 안내는 `.env.local.example` 참고.
#   KIS_TOKEN_STORE: "memory"(기본/폴백) | "kv"(Upstash Redis 공유 store).
#   ⚠️ 서버 전용(NEXT_PUBLIC_ 금지). Vercel Marketplace Upstash 연결 시 자동 주입,
#   미설정 시 memory 폴백이라 머지/실행에 무해(fail-soft).
# KIS_TOKEN_STORE=memory
# KV_REST_API_URL=            # 또는 UPSTASH_REDIS_REST_URL (둘 다 흡수)
# KV_REST_API_TOKEN=          # 또는 UPSTASH_REDIS_REST_TOKEN

# (선택) 로그 레벨 — DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
